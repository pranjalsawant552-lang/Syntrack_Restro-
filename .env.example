# Copy this file to .env and fill in real values before running
# `docker compose up -d --build`. Never commit the real .env file.

# ---- Database ----
# PostgreSQL superuser (or a role with CREATEDB: the app creates one database per tenant)
DB_USERNAME=postgres
DB_PASSWORD=change-me-to-a-strong-password

# ---- JWT ----
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# ---- Outgoing mail (forgot-password, low-stock alerts) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---- Public URLs ----
# The URL your users load the frontend at, and the origin(s) allowed to call the API.
FRONTEND_BASE_URL=https://your-domain.example.com
APP_CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# ---- Initial super admin account ----
SUPERADMIN_EMAIL=superadmin@your-domain.example.com
SUPERADMIN_PASSWORD=change-me-to-a-strong-password
